{
  "info": {
    "name": "EVA 3 - API Control de Inventario y Despachos",
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "description": "Colección completa para pruebas HTTP de la API RESTful (Rúbricas 3.1.1, 3.1.2, 3.1.3, 3.1.4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación JWT",
      "item": [
        {
          "name": "Obtener Tokens (Login Operador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operador\",\n  \"password\": \"operador123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["auth", "token", ""]
            }
          }
        },
        {
          "name": "Refrescar Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["auth", "token", "refresh", ""]
            }
          }
        },
        {
          "name": "Consultar Perfil de Usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/perfil/",
              "host": ["{{base_url}}"],
              "path": ["auth", "perfil", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Productos (CRUD & Filtros)",
      "item": [
        {
          "name": "Listar Productos (Paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/?page=1&page_size=5",
              "host": ["{{base_url}}"],
              "path": ["productos", ""],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar Producto por Nombre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/?search=arroz",
              "host": ["{{base_url}}"],
              "path": ["productos", ""],
              "query": [
                {
                  "key": "search",
                  "value": "arroz"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Despachos (4 Reglas de Negocio)",
      "item": [
        {
          "name": "Regla 1: Inválido (Cantidad 0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": 1,\n  \"cantidad_solicitada\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/despachos/",
              "host": ["{{base_url}}"],
              "path": ["despachos", ""]
            }
          }
        },
        {
          "name": "Regla 2: Rechazado (Excede límite 50)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": 1,\n  \"cantidad_solicitada\": 55\n}"
            },
            "url": {
              "raw": "{{base_url}}/despachos/",
              "host": ["{{base_url}}"],
              "path": ["despachos", ""]
            }
          }
        },
        {
          "name": "Regla 3: Rechazado (Stock Insuficiente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": 5,\n  \"cantidad_solicitada\": 45\n}"
            },
            "url": {
              "raw": "{{base_url}}/despachos/",
              "host": ["{{base_url}}"],
              "path": ["despachos", ""]
            }
          }
        },
        {
          "name": "Regla 4: Aceptado (Despacho Válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": 1,\n  \"cantidad_solicitada\": 20\n}"
            },
            "url": {
              "raw": "{{base_url}}/despachos/",
              "host": ["{{base_url}}"],
              "path": ["despachos", ""]
            }
          }
        }
      ]
    },
    {
      "name": "4. Historial de Movimientos",
      "item": [
